# Copy this file to `.env` and adjust. docker compose reads it automatically.

# Postgres password for the `beans` role. Change for any non-throwaway setup.
POSTGRES_PASSWORD=beans

# Host directory containing config.yaml (mounted to /root/.config/beans).
BEANS_CONFIG_DIR=./config

# Host directory containing the .beancount ledger referenced by config.yaml
# (mounted to /data/ledger).
BEANS_LEDGER_DIR=./ledger

# Host port for the nginx frontend. Default 80.
FRONTEND_PORT=80

# Optional: image-name prefix used when pulling pre-built images from GHCR.
# Leaving this unset keeps locally-built images under the plain `beans-*` name.
# IMAGE_REPO=ghcr.io/your-github-username/beans
